# Root Environment Configuration Template

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Default: SQLite local dev file; or PostgreSQL container/Supabase)
# SQLite (instant local development, zero dependencies):
DATABASE_URL="file:./dev.db"

# PostgreSQL (Docker or Remote Supabase / Cloud):
# DATABASE_URL="postgresql://postgres:mota_secure_password_2026@localhost:5432/mota_scholarship_db?schema=public"

# Authentication
JWT_SECRET=super_secure_mota_tribal_scholarship_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Demo OTP bypass for student login
DEMO_OTP=123456

# Verification Mode (MOCK or LIVE)
VERIFICATION_MODE=MOCK
