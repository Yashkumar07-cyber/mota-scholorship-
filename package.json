{
  "name": "mota-unified-scholarship-platform",
  "version": "1.0.0",
  "description": "Ministry of Tribal Affairs (MoTA) Unified Scholarship Platform",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run vercel-build",
    "vercel-build": "npx prisma generate --schema=database/schema.prisma && cd frontend && npm install && npm run build",
    "use:supabase": "npx tsx scripts/switch-db.ts supabase",
    "use:sqlite": "npx tsx scripts/switch-db.ts sqlite",
    "db:migrate": "cd backend && npm run prisma:push",
    "db:seed": "cd backend && npm run db:seed",
    "db:import": "cd backend && npm run db:import",
    "db:validate": "cd backend && npm run db:validate",
    "test": "cd backend && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.5",
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
